				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>output=$(cat)

errors=$(echo $output | awk -F '::' '/^ERR/ {print $2}')
errors=(${(f)errors})

input=$(echo $output | awk -F '::' '!/OK/ &amp;&amp; !/WARR/ &amp;&amp; !/ERR/ {print}')
input=(${(f)input})

typeset -U paths=()

for p in ${(@)errors}; do
	until [[ $p == "/" ]] || [[ "$input" =~ $p ]]; do
		paths+=($p)
		p=${p:h}
	done

	[[ "$input" =~ $p ]] &amp;&amp; paths+=($p)
done
paths=${(j/::/)paths}

defaults delete "com.vistaprint.onlinedisplay.assetorganizer" "ERRORS"
defaults write "com.vistaprint.onlinedisplay.assetorganizer" "ERRORS" -string "$paths"
</string>
