				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>output=$(cat)

input=$(echo $output | awk -F '::' '!/OK/ &amp;&amp; !/WARR/ &amp;&amp; !/ERR/ {print}')
input=(${(f)input})

error_paths=$(echo $output | awk -F '::' '/^ERR/ &amp;&amp; /FORMAT/ {print $2}')
error_paths=(${(f)error_paths})

for p in ${(@)error_paths}; do
	until [[ $p == "/" ]] || [[ "$input" =~ $p ]]; do
		paths+=($p)
		p=${p:h}
	done

	[[ "$input" =~ $p ]] &amp;&amp; paths+=($p)
done

print -l $paths</string>
